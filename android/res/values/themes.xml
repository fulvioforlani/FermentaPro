<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8-11: splash = sfondo della finestra con il vaso al centro -->
    <style name="Theme.Fermentati" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
    </style>
</resources>
